# These secrets are managed in Doppler (project `travel-map`, config `dev`) and injected via
# `doppler run` — see the README's Hosting section. This file documents the required variables
# and stays usable as a local fallback: copy to `.env` (gitignored — never commit real tokens)
# and load with `node --env-file=.env scripts/build_site.mjs`.

# Mapbox public token (pk....) — baked into web/config.js at build time.
# Restrict it to https://anothersava.com/* in the Mapbox dashboard.
MAPBOX_TOKEN=

# Cloudflare API token with: Account → Cloudflare Pages → Edit,
# and Zone → DNS → Edit (scoped to the anothersava.com zone).
# Stored in the shared `tools` Doppler project and referenced by travel-map.
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (Dashboard → any domain → Overview, right sidebar).
CLOUDFLARE_ACCOUNT_ID=

# Password that unlocks the encrypted visit log (web/data/visits.enc); shared by the
# in-browser unlock and the visits-encrypt / visits-decrypt scripts.
TRAVEL_VISITS_PASSWORD=
